# ============================================================
# Unity Asset Metadata
# ============================================================

# IMPORTANT:
# Do NOT ignore normal *.meta files.
#
# Unity .meta files must be committed alongside their assets.
#
# Only generated metadata associated with ignored/generated
# files is ignored below.

*.pidb.meta
*.pdb.meta
*.mdb.meta

